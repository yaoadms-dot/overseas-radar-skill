        "templates/AGENTS.md",
        "templates/project.json",
        "templates/README.md",
        "templates/项目说明.md"
      ]
    },
    "GENERATED_AT": {
      "type": "string",
      "files": [
        "templates/project.json",
        "templates/README.md"
      ]
    },
    "BASELINE_VERSION": {
