{
  "schema_version": 1,
  "template_id": "software-project-baseline",
  "version": "v1.1.1",
  "compatibility": {
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ],
    "python_min": "3.10.0",
    "powershell_min": "7.4.0",
    "git_min": "2.30.0",
    "entrypoints": {
      "win32": {
        "init": "tools/初始化项目.ps1",
        "check": "tools/检查项目.ps1"
      },
      "darwin": {
        "init": "tools/initialize-project.sh",
        "check": "tools/check-project.sh"
      },
      "linux": {
        "init": "tools/initialize-project.sh",
        "check": "tools/check-project.sh"
      }
    },
    "manifest_schema": 1,
    "upgrade_policy": "explicit-only; immutable project snapshots"
  },
